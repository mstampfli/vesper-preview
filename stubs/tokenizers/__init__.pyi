# Precise local stubs for the parts of `tokenizers` this project uses.
#
# The library ships hints with Any in the places the strict gate forbids. These stubs declare
# only what vesper/tokenizer.py calls, with exact types; anything else is undeclared on purpose.

from collections.abc import Iterable

from tokenizers import decoders as decoders
from tokenizers import models as models
from tokenizers import pre_tokenizers as pre_tokenizers
from tokenizers import trainers as trainers

class Encoding:
    @property
    def ids(self) -> list[int]: ...

class Regex:
    def __init__(self, pattern: str) -> None: ...

class Tokenizer:
    pre_tokenizer: pre_tokenizers.PreTokenizer | None
    decoder: decoders.Decoder | None
    def __init__(self, model: models.Model) -> None: ...
    def encode(self, sequence: str, add_special_tokens: bool = ...) -> Encoding: ...
    def decode(self, ids: list[int], skip_special_tokens: bool = ...) -> str: ...
    def get_vocab_size(self, with_added_tokens: bool = ...) -> int: ...
    def train_from_iterator(
        self, iterator: Iterable[str], trainer: trainers.Trainer | None = ...
    ) -> None: ...
    def save(self, path: str, pretty: bool = ...) -> None: ...
    def to_str(self, pretty: bool = ...) -> str: ...
    @staticmethod
    def from_file(path: str) -> Tokenizer: ...
