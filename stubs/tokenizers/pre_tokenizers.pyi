from tokenizers import Regex

class PreTokenizer:
    def pre_tokenize_str(self, sequence: str) -> list[tuple[str, tuple[int, int]]]: ...

class ByteLevel(PreTokenizer):
    def __init__(self, add_prefix_space: bool = ..., use_regex: bool = ...) -> None: ...
    @staticmethod
    def alphabet() -> list[str]: ...

class Split(PreTokenizer):
    def __init__(self, pattern: str | Regex, behavior: str, invert: bool = ...) -> None: ...

class Sequence(PreTokenizer):
    def __init__(self, pretokenizers: list[PreTokenizer]) -> None: ...
