# Precise local stubs for the parts of `triton.language` our kernels use (see ../__init__.pyi).
#
# The names mirror the library's own (lowercase classes, `max`, `sum`, `abs`), hence the noqa
# marks. Inside a jitted function a `constexpr` parameter behaves as its compile-time int (loop
# bounds, block sizes), so it is declared as an int here.

class dtype:  # noqa: N801
    element_ty: dtype

_DType = dtype  # the class, under a name a tensor's own ``dtype`` attribute cannot shadow

float32: dtype
int64: dtype

class constexpr(int): ...  # noqa: N801

class tensor:  # noqa: N801
    dtype: _DType
    def __add__(self, other: tensor | float) -> tensor: ...
    def __radd__(self, other: float) -> tensor: ...
    def __sub__(self, other: tensor | float) -> tensor: ...
    def __rsub__(self, other: float) -> tensor: ...
    def __mul__(self, other: tensor | float) -> tensor: ...
    def __rmul__(self, other: float) -> tensor: ...
    def __truediv__(self, other: tensor | float) -> tensor: ...
    def __rtruediv__(self, other: float) -> tensor: ...
    def __and__(self, other: tensor) -> tensor: ...
    def __floordiv__(self, other: tensor | int) -> tensor: ...
    def __mod__(self, other: tensor | int) -> tensor: ...
    def __getitem__(self, index: object) -> tensor: ...
    def __ge__(self, other: tensor | float) -> tensor: ...
    def __lt__(self, other: tensor | int) -> tensor: ...
    def __eq__(self, other: tensor | int) -> tensor: ...  # type: ignore[override]
    def to(self, dtype: _DType) -> tensor: ...

def program_id(axis: int) -> tensor: ...
def num_programs(axis: int) -> tensor: ...
def static_range(stop: int) -> range: ...
def arange(start: int, end: int) -> tensor: ...
def full(shape: tuple[int, ...], value: float, dtype: dtype) -> tensor: ...
def load(pointer: tensor, mask: tensor | None = None, other: float | None = None) -> tensor: ...
def store(pointer: tensor, value: tensor, mask: tensor | None = None) -> None: ...
def max(x: tensor, axis: int) -> tensor: ...  # noqa: A001
def sum(x: tensor, axis: int) -> tensor: ...  # noqa: A001
def maximum(x: tensor, y: tensor | float) -> tensor: ...
def abs(x: tensor) -> tensor: ...  # noqa: A001
def sqrt(x: tensor) -> tensor: ...
def exp(x: tensor) -> tensor: ...
def log(x: tensor) -> tensor: ...
def where(condition: tensor, x: tensor, y: tensor | float) -> tensor: ...
