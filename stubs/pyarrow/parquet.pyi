from types import TracebackType
from typing import Self

from pyarrow import Schema, Table

class RowGroupMetaData:
    num_rows: int

class FileMetaData:
    num_row_groups: int
    num_rows: int
    def row_group(self, i: int) -> RowGroupMetaData: ...

class ParquetFile:
    metadata: FileMetaData
    schema_arrow: Schema
    def __init__(self, source: str) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...
    def close(self, force: bool = ...) -> None: ...
    def read_row_group(self, i: int, columns: list[str] | None = ...) -> Table: ...

class ParquetWriter:
    def __init__(self, where: str, schema: Schema) -> None: ...
    def write_table(self, table: Table, row_group_size: int | None = ...) -> None: ...
    def close(self) -> None: ...

def write_table(table: Table, where: str, row_group_size: int | None = ...) -> None: ...
def read_table(source: str, columns: list[str] | None = ...) -> Table: ...
